# ===== apps/web/.env.local =====
# URL da API vista pelo NAVEGADOR (vai para o código público). Precisa estar liberada no CORS_ORIGINS da API.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# URL da API vista pelo SERVIDOR do site (BFF). Pode ser a mesma.
API_URL=http://localhost:3333/api/v1
# OBRIGATÓRIO em produção: origens do site que podem fazer login/refresh (proteção CSRF), separadas por vírgula.
# Inclua o domínio com e sem "www". Atrás de proxy/hospedagem o Next pode enxergar um host interno, por isso a lista explícita.
# WEB_ORIGINS=https://minhasdespesas021.com.br,https://www.minhasdespesas021.com.br
# Dias de validade do cookie de sessão (igual a REFRESH_TOKEN_TTL_DAYS da API)
# REFRESH_COOKIE_DAYS=30

