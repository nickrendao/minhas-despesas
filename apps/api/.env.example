# ===== Copie para apps/api/.env e preencha. NUNCA envie o .env para o Git. =====
NODE_ENV=development
PORT=3333

# Banco PostgreSQL (local: docker compose up -d db).  No Supabase: use a string do painel
# (Project Settings > Database). Para rodar migrations use conexão DIRETA ou "Session pooler" (porta 5432).
DATABASE_URL=postgresql://fin:fin_dev_pw@localhost:5432/fin_dev

# Gere um segredo FORTE e único:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origens do site autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
WEB_URL=http://localhost:3000

# Confirmação de e-mail no cadastro (recomendado: true em produção)
REQUIRE_EMAIL_VERIFICATION=true
# console = só imprime no log (desenvolvimento) | smtp = envia de verdade (precisa de SMTP_URL)
MAIL_MODE=console
# SMTP_URL=smtps://usuario:senha@smtp.seuprovedor.com:465
MAIL_FROM="Minhas Despesas <no-reply@minhasdespesas021.com.br>"

# Opcional: chave "demo" gratuita da CoinGecko (reduz risco de limite de requisições)
# COINGECKO_API_KEY=

# Atrás de proxy/hospedagem (Render, Fly, Railway...): quantos proxies confiar para descobrir o IP real
TRUST_PROXY=1
